---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import { ArrowLeft, Clock, GitBranch, ArrowRight } from 'lucide-react';

interface Props {
  title: string;
  tagline: string;
  categoryLabel: string;
  deliverableType: string;
  targetBuyer: string;
  stack: string[];
  readTime: string;
  publishDate: string;
  metrics: { label: string; value: string }[];
  repoUrl?: string;
  nextSlug?: string;
  nextTitle?: string;
}

const {
  title,
  tagline,
  categoryLabel,
  deliverableType,
  targetBuyer,
  stack,
  readTime,
  publishDate,
  metrics,
  repoUrl = 'https://github.com/bhanot1054',
  nextSlug,
  nextTitle,
} = Astro.props;

const tocItems = [
  { id: 'executive-summary', label: '1. Executive Metadata' },
  { id: 'voc-research', label: '2. VoC Research & Objections' },
  { id: 'mechanism-matrix', label: '3. Mechanism-to-Benefit Matrix' },
  { id: 'deliverable-in-context', label: '4. The Deliverable in Context' },
  { id: 'engineering-proof', label: '5. Engineering Proof & Verification' },
];
---

<BaseLayout title={title} description={tagline} articleDate={publishDate}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-20">
    <!-- Breadcrumb -->
    <div class="mb-8 flex items-center justify-between text-xs font-mono font-medium">
      <a
        href="/work"
        class="inline-flex items-center gap-2 text-[#57534E] hover:text-[#1C1B19] transition-colors bg-[#FDFBF7] px-3.5 py-1.5 rounded-full border border-[#1C1B19]/8 shadow-paper-sm"
      >
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>Back to Work Archive</span>
      </a>
      <span class="text-[#1C1B19] font-semibold bg-[#EAF57A] px-3 py-1 rounded-full border border-[#1C1B19]/10 shadow-sm hidden sm:inline">SAMPLE #0 VERIFIED</span>
    </div>

    {/* Section 1: Executive Metadata Header */}
    <header id="executive-summary" class="mb-14 scroll-mt-24 relative bg-[#FDFBF7] rounded-3xl p-6 sm:p-10 border border-[#1C1B19]/8 shadow-paper-md overflow-hidden">
      <div class="masking-tape masking-tape-lavender"></div>

      <div class="relative z-10 space-y-6">
        <div class="flex flex-wrap items-center gap-2.5">
          <Badge text={deliverableType} variant="lavender" size="sm" />
          <Badge text={categoryLabel} variant="peach" size="sm" />
          <span class="text-[#57534E] text-xs font-mono font-medium flex items-center gap-1.5 ml-auto">
            <Clock className="w-3.5 h-3.5 text-[#1C1B19]" />
            {readTime}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#1C1B19] font-display leading-[1.12]">
          {title}
        </h1>

        <p class="text-[#57534E] text-base sm:text-lg max-w-3xl leading-relaxed font-sans font-medium">
          {tagline}
        </p>

        <!-- Metadata Attributes Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-[#1C1B19]/8 text-xs font-mono">
          <div class="p-3.5 rounded-2xl bg-[#F4F1EA]/70 border border-[#1C1B19]/6 shadow-paper-sm space-y-1">
            <div class="text-[#8A857D] uppercase tracking-wider text-[10px] font-semibold">Target Buyer Persona</div>
            <div class="text-[#1C1B19] font-bold">{targetBuyer}</div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#F4F1EA]/70 border border-[#1C1B19]/6 shadow-paper-sm space-y-1">
            <div class="text-[#8A857D] uppercase tracking-wider text-[10px] font-semibold">Core Stack Covered</div>
            <div class="text-[#1C1B19] font-bold truncate">{stack.join(' • ')}</div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#F4F1EA]/70 border border-[#1C1B19]/6 shadow-paper-sm space-y-1">
            <div class="text-[#8A857D] uppercase tracking-wider text-[10px] font-semibold">Production Status</div>
            <div class="text-[#1C1B19] font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#16A34A]"></span>
              <span>Code-Verified & Live</span>
            </div>
          </div>
        </div>

        <!-- Telemetry Metrics Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 font-mono">
          {metrics.map(m => (
            <div class="bg-white p-3.5 rounded-2xl border border-[#1C1B19]/8 shadow-paper-sm">
              <div class="text-[10px] text-[#8A857D] uppercase font-semibold">{m.label}</div>
              <div class="text-[#16A34A] font-extrabold text-base sm:text-lg mt-0.5">{m.value}</div>
            </div>
          ))}
        </div>
      </div>
    </header>

    <!-- Main Content Grid with Desktop Sticky Left Table of Contents -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      {/* Sticky Table of Contents (Desktop) */}
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 bg-[#FDFBF7] rounded-2xl p-5 border border-[#1C1B19]/8 shadow-paper-md text-xs font-mono space-y-4">
        <div class="text-[#1C1B19] font-extrabold tracking-wider uppercase text-xs pb-2 border-b border-[#1C1B19]/8">
          // Outline
        </div>
        <nav class="space-y-2 font-medium">
          {tocItems.map(item => (
            <a
              href={`#${item.id}`}
              class="block text-[#57534E] hover:text-[#1C1B19] hover:font-bold transition-colors py-1 pl-2 border-l-2 border-[#1C1B19]/10 hover:border-[#1C1B19]"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="pt-4 border-t border-[#1C1B19]/8 space-y-2">
          <div class="text-[10px] text-[#8A857D] uppercase tracking-wider font-semibold">Companion Code</div>
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-[#1C1B19] font-bold hover:text-[#57534E]"
          >
            <GitBranch className="w-3.5 h-3.5 text-[#1C1B19]" />
            <span>GitHub Repository</span>
          </a>
        </div>
      </aside>

      {/* Main Prose / MDX Slot */}
      <main class="lg:col-span-9 space-y-12">
        <div class="prose max-w-none prose-headings:font-display prose-headings:tracking-tight prose-headings:text-[#1C1B19] prose-p:text-[#3D3A36] prose-p:leading-relaxed prose-code:font-mono prose-code:text-[#1C1B19] prose-pre:rounded-2xl prose-pre:border prose-pre:border-[#1C1B19]/10 prose-pre:shadow-paper-sm">
          <slot />
        </div>

        {/* Section 5: Companion Engineering Proof */}
        <section id="engineering-proof" class="scroll-mt-24 pt-8 border-t border-[#1C1B19]/8 space-y-6">
          <div class="bg-[#FDFBF7] rounded-3xl p-6 sm:p-8 border border-[#1C1B19]/8 shadow-paper-md flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div class="space-y-2">
              <span class="text-xs font-mono uppercase tracking-wider text-[#1C1B19] font-bold">
                // Companion Code & Tests
              </span>
              <h3 class="text-xl font-extrabold tracking-tight text-[#1C1B19]">
                Inspect The Bare-Metal Codebase
              </h3>
              <p class="text-[#57534E] text-xs sm:text-sm max-w-xl font-sans font-medium">
                Every claim, metric, and architecture diagram in this case study is accompanied by runnable tests and benchmark scripts in the GitHub repository.
              </p>
            </div>

            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-full text-xs font-sans font-bold bg-[#1C1B19] text-[#FDFBF7] hover:bg-[#3D3A36] shadow-paper-sm hover:shadow-paper-md hover:-translate-y-0.5 transition-all inline-flex items-center gap-2 shrink-0"
            >
              <GitBranch className="w-4 h-4 text-[#E3DEFA]" />
              <span>Clone & Test Locally</span>
            </a>
          </div>

          {/* Next Case Study Navigation */}
          {nextSlug && (
            <div class="flex items-center justify-between pt-6 text-xs font-mono font-semibold">
              <span class="text-[#8A857D] uppercase tracking-wider">Next Artifact:</span>
              <a
                href={`/work/${nextSlug}`}
                class="inline-flex items-center gap-2 text-[#1C1B19] hover:text-[#57534E] transition-colors underline decoration-2 decoration-[#E3DEFA]"
              >
                <span>{nextTitle}</span>
                <ArrowRight className="w-3.5 h-3.5 text-[#1C1B19]" />
              </a>
            </div>
          )}
        </section>
      </main>
    </div>
  </div>
</BaseLayout>
