---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSpecTranslator from '../components/interactive/HeroSpecTranslator.tsx';
import HeroMarkupScrub from '../components/interactive/HeroMarkupScrub.tsx';
import PinnedTeardown from '../components/interactive/PinnedTeardown.tsx';
import FannedProofCards from '../components/interactive/FannedProofCards.tsx';
import PinnedPipeline from '../components/interactive/PinnedPipeline.tsx';
import CleanCtaSection from '../components/interactive/CleanCtaSection.tsx';
import ChapterRail from '../components/ui/ChapterRail.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import SpiralNotebookCard from '../components/ui/SpiralNotebookCard.astro';
import TornPaperStrip from '../components/ui/TornPaperStrip.astro';
import StickerTile from '../components/ui/StickerTile.astro';
import HandDrawnDoodles from '../components/ui/HandDrawnDoodles.astro';
import Badge from '../components/ui/Badge.astro';
import { ArrowRight, ShieldCheck, Terminal } from 'lucide-react';
---

<BaseLayout
  title="Jatin Bhanot // Technical Copywriter & Systems Engineer"
  description="Technical Copy That Skeptical Engineers Actually Trust. Translating Rust, C++20, and on-device AI architectures into high-converting developer marketing."
>
  <!-- Slim Side Rail (01 MESS ... 05 CLEAN) with Scroll-Linked Progress Line -->
  <ChapterRail />

  <!-- CHAPTER 01: MESS (The Raw Spec Desk & The 5-Second Impression) -->
  <section id="chapter-1" class="relative pt-6 pb-16 sm:pb-24 overflow-hidden border-b border-[#1C1B19]/8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Top Meta Row -->
      <div class="flex items-center justify-between text-xs font-mono text-[#57534E] border-b border-[#1C1B19]/8 pb-4 mb-8 sm:mb-12">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
          <span class="tracking-wider uppercase font-semibold text-[#1C1B19]">Personal Branding & Technical Copy</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline text-[11px] text-[#57534E]">B2B DevTools & Systems Architecture</span>
          <span class="bg-[#F4F1EA] px-2.5 py-0.5 rounded-full border border-[#1C1B19]/10 font-bold text-[#1C1B19]">2026</span>
        </div>
      </div>

      <!-- 2-Column Split Hero (The 10-Second Impression) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 sm:gap-12 items-center">
        <!-- Left Column: High-Stakes Positioning & Trust -->
        <div class="lg:col-span-6 space-y-5">
          <!-- Monospace Stamped Eyebrow Pill -->
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#F4F1EA] rounded-full border border-[#1C1B19]/10 text-[#1C1B19] font-mono text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-[#1C1B19] animate-pulse"></span>
            SYSTEMS ENGINEER TURNED TECHNICAL COPYWRITER
          </div>

          <!-- Title Case Display Headline with Soft Lavender Highlighter -->
          <h1 class="text-4xl sm:text-5xl lg:text-[3.35rem] font-bold tracking-tight text-[#1C1B19] font-sans leading-[1.1]">
            Technical Copy That Skeptical Engineers <span class="inline-block bg-[#E3DEFA] px-3.5 py-0.5 rounded-2xl text-[#1C1B19] shadow-xs rotate-[-0.5deg]">Actually Trust.</span>
          </h1>

          <p class="text-[#57534E] text-base sm:text-lg leading-relaxed max-w-xl font-sans">
            I build <strong class="text-[#1C1B19] font-semibold">Rust</strong>, <strong class="text-[#1C1B19] font-semibold">C++20</strong>, and <strong class="text-[#1C1B19] font-semibold">on-device AI systems</strong>—and translate complex kernel & agent architectures into high-converting landing pages, code-backed deep dives, and developer launches.
          </p>

          <!-- Interactive Scroll-Scrubbed Red-Pen Strikethrough Memo Scrap -->
          <HeroMarkupScrub client:load />

          <!-- Tactile CTAs: Primary & Secondary -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="/contact?teardown=true"
              class="cta-shine-btn px-6 py-3.5 rounded-full text-xs font-sans font-semibold tracking-wide bg-[#1C1B19] text-[#FDFBF7] hover:bg-[#3D3A36] shadow-paper-md hover:translate-y-[-1px] transition-all inline-flex items-center gap-2 cursor-pointer"
            >
              <span>Get a Free 2-Minute Video Teardown</span>
              <ArrowRight className="w-4 h-4" />
            </a>

            <a
              href="#chapter-3"
              class="px-6 py-3.5 rounded-full text-xs font-sans font-semibold tracking-wide bg-[#FDFBF7] border border-[#1C1B19]/15 text-[#1C1B19] hover:bg-[#F4F1EA] shadow-paper-sm hover:translate-y-[-1px] transition-all inline-flex items-center gap-2 cursor-pointer"
            >
              <span>See The Proof ↓</span>
            </a>
          </div>

          <!-- Floating Die-Cut Sticker Tiles & Hand-Drawn Arrow -->
          <div class="pt-3 flex items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <StickerTile name="Rust" color="#FADEC9" rotate="-2deg" class="paper-float-slow" />
              <StickerTile name="Linux LSM" color="#E3DEFA" rotate="1.5deg" class="paper-float-reverse" />
              <StickerTile name="On-Device AI" color="#D7F0DE" rotate="-1.5deg" class="paper-float-slow" />
              <StickerTile name="C++20" color="#EAF57A" rotate="2deg" class="paper-float-reverse" />
            </div>

            <div class="hidden sm:block">
              <HandDrawnDoodles type="arrow-curved" class="w-16 h-8 text-[#1C1B19]/50" />
            </div>
          </div>

          <!-- Micro Trust Bullet -->
          <div class="pt-1 flex items-center gap-2 text-xs font-mono text-[#57534E]">
            <ShieldCheck className="w-4 h-4 text-[#1C1B19] shrink-0" />
            <span>Zero generic AI fluff • 100% code-verified & runnable architectures</span>
          </div>
        </div>

        <!-- Right Column: Interactive "Spec-to-Copy" Live Demo Island (client:load) -->
        <div class="lg:col-span-6 w-full relative">
          <div class="masking-tape -top-3 left-1/2 -translate-x-1/2 z-20"></div>
          <HeroSpecTranslator client:load />
        </div>
      </div>

      <!-- Trust Strip Right Under Hero (My Shipped Projects + Live Status) -->
      <div class="mt-14 pt-6 border-t border-[#1C1B19]/8 grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
        <div class="md:col-span-3">
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#1C1B19] block">
            // My Shipped Projects:
          </span>
          <span class="text-xs text-[#57534E]">Real codebases on GitHub</span>
        </div>

        <div class="md:col-span-6 flex flex-wrap items-center gap-2">
          <a
            href="https://github.com/bhanot1054/agent-radar"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full bg-[#FAF7F0] border border-[#1C1B19]/10 text-xs font-mono font-medium text-[#1C1B19] hover:bg-[#E3DEFA] transition-colors flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
            <span>Agent-Radar (Rust/epoll)</span>
          </a>
          <a
            href="https://github.com/bhanot1054/neuroos-sandbox"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full bg-[#FAF7F0] border border-[#1C1B19]/10 text-xs font-mono font-medium text-[#1C1B19] hover:bg-[#FADEC9] transition-colors flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
            <span>Semantic-NeuroOS (Landlock LSM)</span>
          </a>
          <span class="px-3 py-1 rounded-full bg-[#FAF7F0] border border-[#1C1B19]/10 text-xs font-mono font-medium text-[#1C1B19] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
            <span>UAV Vision (YOLO11n + ByteTrack + SAHI)</span>
          </span>
        </div>

        <div class="md:col-span-3 md:text-right">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D7F0DE] border border-[#1C1B19]/10 text-xs font-mono font-semibold text-[#1C1B19]">
            <span class="w-2 h-2 rounded-full bg-[#1C1B19] animate-pulse"></span>
            <span>Accepting Select Projects</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 02: TEARDOWN (Pinned Scroll Strikethrough & Assembly) -->
  <PinnedTeardown client:visible />

  <!-- CHAPTER 03: PROOF (Blueprint Background Transition & Fanned-Out Cards) -->
  <FannedProofCards client:visible />

  <!-- Systems Scrapbook Desk Details (Field Notes & Shipped Strips) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20 border-b border-[#1C1B19]/8">
    <SectionHeader
      eyebrow="ENGINEERING FIELD NOTES"
      title="The Systems Scrapbook"
      subtitle="Before I write a single headline, I deconstruct your repository. Real codebases, actual syscall mechanics, zero marketing hand-waving."
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left: Spiral Notebook Card with Core Stacks & Telemetry -->
      <div class="lg:col-span-5">
        <SpiralNotebookCard hasTape={true} tapeColor="lavender" class="paper-fold">
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-[#1C1B19]/8 pb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#1C1B19] flex items-center gap-1.5">
                <Terminal className="w-3.5 h-3.5" />
                <span>Field Notes: Technical Audits</span>
              </span>
              <span class="text-[11px] font-mono text-[#57534E]">v2.6.4</span>
            </div>

            <h3 class="text-lg font-bold text-[#1C1B19] font-sans">
              Why DevTools founders hire me:
            </h3>

            <p class="text-xs text-[#57534E] leading-relaxed">
              Standard agency copywriters do not know the difference between user-space polling and kernel-level epoll multiplexing. They write vague fluff that turns off senior staff engineers.
            </p>

            <!-- Pastel Highlight Strips -->
            <div class="space-y-2 pt-2">
              <div class="p-2.5 rounded-xl bg-[#E3DEFA] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>Kernel Landlock & epoll:</strong> Non-polling event sleep on idle
              </div>
              <div class="p-2.5 rounded-xl bg-[#FADEC9] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>BitNet b1.58:</strong> 1.58-bit ternary matrix kernels on CPU
              </div>
              <div class="p-2.5 rounded-xl bg-[#F7D6DE] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>Landlock LSM Isolation:</strong> Egress lockdown without hypervisor overhead
              </div>
              <div class="p-2.5 rounded-xl bg-[#EAF57A] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>Shipped Repositories:</strong> Open-source systems and AI tools on GitHub
              </div>
            </div>

            <div class="pt-2 flex items-center justify-between text-[11px] font-mono text-[#57534E]">
              <span>Status: Currently accepting select projects</span>
              <a href="/contact" class="font-bold text-[#1C1B19] hover:underline">Inquire for dates →</a>
            </div>
          </div>
        </SpiralNotebookCard>
      </div>

      <!-- Right: 3 Stacked Torn Paper Strips -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Strip 1: Semantic-NeuroOS -->
        <TornPaperStrip tilt="left" hasTape={true} class="relative paper-fold">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <Badge text="ON-DEVICE AI" variant="lavender" />
                <span class="text-xs font-mono text-[#57534E]">Semantic-NeuroOS</span>
              </div>
              <h4 class="text-base font-bold text-[#1C1B19] font-sans">
                Zero-Egress On-Device AI Agent Runner
              </h4>
              <p class="text-xs text-[#57534E] leading-relaxed">
                Spec sample demonstrating strict Linux Landlock LSM policies blocking socket creation (<code class="bg-[#F4F1EA] px-1 py-0.5 rounded text-[11px] font-mono">AF_INET = EACCES</code>). Kernel-enforced policy restricting socket creation and outbound network egress.
              </p>
            </div>
            <div class="text-right shrink-0">
              <div class="text-sm font-bold font-mono text-[#1C1B19]">0 Bytes</div>
              <div class="text-[10px] text-[#57534E] font-mono">Network Egress</div>
            </div>
          </div>
        </TornPaperStrip>

        <!-- Strip 2: Agent-Radar -->
        <TornPaperStrip tilt="right" hasTape={true} class="relative paper-fold">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <Badge text="RUST / LINUX" variant="peach" />
                <span class="text-xs font-mono text-[#57534E]">Agent-Radar</span>
              </div>
              <h4 class="text-base font-bold text-[#1C1B19] font-sans">
                Real-Time Linux Kernel Ingestion Pipeline
              </h4>
              <p class="text-xs text-[#57534E] leading-relaxed">
                Replaced polling loops with kernel <code class="bg-[#F4F1EA] px-1 py-0.5 rounded text-[11px] font-mono">epoll_wait</code> and <code class="bg-[#F4F1EA] px-1 py-0.5 rounded text-[11px] font-mono">inotify</code>. Eliminates background CPU polling entirely by sleeping in the kernel until file descriptor events fire.
              </p>
            </div>
            <div class="text-right shrink-0">
              <div class="text-sm font-bold font-mono text-[#1C1B19]">Pending</div>
              <div class="text-[10px] text-[#57534E] font-mono">Idle Measurement</div>
            </div>
          </div>
        </TornPaperStrip>

        <!-- Strip 3: UAV Traffic Analytics Research -->
        <TornPaperStrip tilt="left" hasTape={true} class="relative paper-fold">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <Badge text="COMPUTER VISION / UAV" variant="sage" />
                <span class="text-xs font-mono text-[#57534E]">NFU Taiwan Fellowship</span>
              </div>
              <h4 class="text-base font-bold text-[#1C1B19] font-sans">
                UAV Traffic-Analytics Prototype
              </h4>
              <p class="text-xs text-[#57534E] leading-relaxed">
                Engineered real-time aerial video inference using YOLO11n, ByteTrack, and SAHI (Slicing Aided Hyper Inference) for small-vehicle detection during the NFU Taiwan research fellowship.
              </p>
            </div>
            <div class="text-right shrink-0">
              <div class="text-sm font-bold font-mono text-[#1C1B19]">SAHI Tiling</div>
              <div class="text-[10px] text-[#57534E] font-mono">ByteTrack Matching</div>
            </div>
          </div>
        </TornPaperStrip>
      </div>
    </div>
  </section>

  <!-- CHAPTER 04: PIPELINE (Pinned 70/30 Research-First Workflow) -->
  <PinnedPipeline client:visible />

  <!-- CHAPTER 05: CLEAN (Converging Scraps, Approved Stamp & Magnetic CTA) -->
  <CleanCtaSection client:visible />
</BaseLayout>