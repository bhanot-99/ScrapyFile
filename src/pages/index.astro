---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSpecTranslator from '../components/interactive/HeroSpecTranslator.tsx';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PaperCard from '../components/ui/PaperCard.astro';
import SpiralNotebookCard from '../components/ui/SpiralNotebookCard.astro';
import TornPaperStrip from '../components/ui/TornPaperStrip.astro';
import StickerTile from '../components/ui/StickerTile.astro';
import HandDrawnDoodles from '../components/ui/HandDrawnDoodles.astro';
import Badge from '../components/ui/Badge.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight, ShieldCheck, Terminal } from 'lucide-react';

const allWork = await getCollection('work');
const featuredWork = allWork
  .filter(item => item.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Jatin Bhanot // Technical Copywriter & Systems Engineer"
  description="Technical Copy That Skeptical Engineers Actually Trust. Translating Rust, C++20, and on-device AI architectures into high-converting developer marketing."
>
  <!-- Hero Section (The Warm Editorial Desk) -->
  <section class="relative pt-6 pb-16 sm:pb-24 overflow-hidden border-b border-[#1C1B19]/8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Top Meta Row -->
      <div class="flex items-center justify-between text-xs font-mono text-[#57534E] border-b border-[#1C1B19]/8 pb-4 mb-8 sm:mb-12">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
          <span class="tracking-wider uppercase font-semibold text-[#1C1B19]">Personal Branding & Technical Copy</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline text-[11px] text-[#57534E]">B2B DevTools & Systems Architecture</span>
          <span class="bg-[#F4F1EA] px-2.5 py-0.5 rounded-full border border-[#1C1B19]/10 font-bold text-[#1C1B19]">2026</span>
        </div>
      </div>

      <!-- 2-Column Split Hero (The 10-Second Impression) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 sm:gap-12 items-center">
        <!-- Left Column: High-Stakes Positioning & Trust -->
        <div class="lg:col-span-6 space-y-6">
          <!-- Monospace Stamped Eyebrow Pill -->
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#F4F1EA] rounded-full border border-[#1C1B19]/10 text-[#1C1B19] font-mono text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-[#1C1B19] animate-pulse"></span>
            SYSTEMS ENGINEER TURNED TECHNICAL COPYWRITER
          </div>

          <!-- Title Case Display Headline with Soft Lavender Highlighter -->
          <h1 class="text-4xl sm:text-5xl lg:text-[3.35rem] font-bold tracking-tight text-[#1C1B19] font-sans leading-[1.1]">
            Technical Copy That Skeptical Engineers <span class="inline-block bg-[#E3DEFA] px-3.5 py-0.5 rounded-2xl text-[#1C1B19] shadow-xs rotate-[-0.5deg]">Actually Trust.</span>
          </h1>

          <p class="text-[#57534E] text-base sm:text-lg leading-relaxed max-w-xl font-sans">
            I build <strong class="text-[#1C1B19] font-semibold">Rust</strong>, <strong class="text-[#1C1B19] font-semibold">C++20</strong>, and <strong class="text-[#1C1B19] font-semibold">on-device AI systems</strong>—and translate complex kernel & agent architectures into high-converting landing pages, code-backed deep dives, and developer launches.
          </p>

          <!-- Tactile CTAs: Primary & Secondary -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="/contact?teardown=true"
              class="cta-shine-btn px-6 py-3.5 rounded-full text-xs font-sans font-semibold tracking-wide bg-[#1C1B19] text-[#FDFBF7] hover:bg-[#3D3A36] shadow-paper-md hover:translate-y-[-1px] transition-all inline-flex items-center gap-2 cursor-pointer"
            >
              <span>Get a Free 2-Minute Video Teardown</span>
              <ArrowRight className="w-4 h-4" />
            </a>

            <a
              href="#proof"
              class="px-6 py-3.5 rounded-full text-xs font-sans font-semibold tracking-wide bg-[#FDFBF7] border border-[#1C1B19]/15 text-[#1C1B19] hover:bg-[#F4F1EA] shadow-paper-sm hover:translate-y-[-1px] transition-all inline-flex items-center gap-2 cursor-pointer"
            >
              <span>See The Proof ↓</span>
            </a>
          </div>

          <!-- Floating Die-Cut Sticker Tiles & Hand-Drawn Arrow -->
          <div class="pt-4 flex items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <StickerTile name="Rust" color="#FADEC9" rotate="-2deg" class="paper-float-slow" />
              <StickerTile name="Linux LSM" color="#E3DEFA" rotate="1.5deg" class="paper-float-reverse" />
              <StickerTile name="On-Device AI" color="#D7F0DE" rotate="-1.5deg" class="paper-float-slow" />
              <StickerTile name="C++20" color="#EAF57A" rotate="2deg" class="paper-float-reverse" />
            </div>

            <div class="hidden sm:block">
              <HandDrawnDoodles type="arrow-curved" class="w-16 h-8 text-[#1C1B19]/50" />
            </div>
          </div>

          <!-- Micro Trust Bullet -->
          <div class="pt-1 flex items-center gap-2 text-xs font-mono text-[#57534E]">
            <ShieldCheck className="w-4 h-4 text-[#1C1B19] shrink-0" />
            <span>Zero generic AI fluff • 100% code-verified & runnable architectures</span>
          </div>
        </div>

        <!-- Right Column: Interactive "Spec-to-Copy" Live Demo Island (client:load) -->
        <div class="lg:col-span-6 w-full relative">
          <div class="masking-tape -top-3 left-1/2 -translate-x-1/2 z-20"></div>
          <HeroSpecTranslator client:load />
        </div>
      </div>

      <!-- Trust Strip Right Under Hero (My Shipped Projects + Live Status) -->
      <div class="mt-14 pt-6 border-t border-[#1C1B19]/8 grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
        <div class="md:col-span-3">
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#1C1B19] block">
            // My Shipped Projects:
          </span>
          <span class="text-xs text-[#57534E]">Real codebases on GitHub</span>
        </div>

        <div class="md:col-span-6 flex flex-wrap items-center gap-2">
          <a
            href="https://github.com/bhanot1054/agent-radar"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full bg-[#FAF7F0] border border-[#1C1B19]/10 text-xs font-mono font-medium text-[#1C1B19] hover:bg-[#E3DEFA] transition-colors flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
            <span>Agent-Radar (Rust/epoll)</span>
          </a>
          <a
            href="https://github.com/bhanot1054/neuroos-sandbox"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full bg-[#FAF7F0] border border-[#1C1B19]/10 text-xs font-mono font-medium text-[#1C1B19] hover:bg-[#FADEC9] transition-colors flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
            <span>Semantic-NeuroOS (Landlock LSM)</span>
          </a>
          <span class="px-3 py-1 rounded-full bg-[#FAF7F0] border border-[#1C1B19]/10 text-xs font-mono font-medium text-[#1C1B19] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#1C1B19]"></span>
            <span>UAV Vision (YOLO11n + ByteTrack + SAHI)</span>
          </span>
        </div>

        <div class="md:col-span-3 md:text-right">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D7F0DE] border border-[#1C1B19]/10 text-xs font-mono font-semibold text-[#1C1B19]">
            <span class="w-2 h-2 rounded-full bg-[#1C1B19] animate-pulse"></span>
            <span>Accepting Select Projects</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mid-Page Scrapbook Collage: Engineer Proof & Systems Notebook -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24 border-b border-[#1C1B19]/8">
    <SectionHeader
      eyebrow="ENGINEERING PROOF // UNDER THE HOOD"
      title="The Systems Scrapbook"
      subtitle="Before I write a single headline, I deconstruct your repository. Real codebases, actual syscall mechanics, zero marketing hand-waving."
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left: Spiral Notebook Card with Core Stacks & Telemetry -->
      <div class="lg:col-span-5">
        <SpiralNotebookCard hasTape={true} tapeColor="lavender" class="paper-fold">
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-[#1C1B19]/8 pb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#1C1B19] flex items-center gap-1.5">
                <Terminal className="w-3.5 h-3.5" />
                <span>Field Notes: Technical Audits</span>
              </span>
              <span class="text-[11px] font-mono text-[#57534E]">v2.6.4</span>
            </div>

            <h3 class="text-lg font-bold text-[#1C1B19] font-sans">
              Why DevTools founders hire me:
            </h3>

            <p class="text-xs text-[#57534E] leading-relaxed">
              Standard agency copywriters do not know the difference between user-space ring buffers and kernel-level epoll multiplexing. They write vague fluff that turns off senior staff engineers.
            </p>

            <!-- Pastel Highlight Strips -->
            <div class="space-y-2 pt-2">
              <div class="p-2.5 rounded-xl bg-[#E3DEFA] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>Kernel Landlock & epoll:</strong> Zero CPU idle wakeups on wait
              </div>
              <div class="p-2.5 rounded-xl bg-[#FADEC9] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>BitNet b1.58:</strong> 1.58-bit ternary matrix kernels on CPU
              </div>
              <div class="p-2.5 rounded-xl bg-[#F7D6DE] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>MicroVM Isolation:</strong> Egress lockdown without hypervisor overhead
              </div>
              <div class="p-2.5 rounded-xl bg-[#EAF57A] text-xs font-mono text-[#1C1B19] border border-[#1C1B19]/10">
                <strong>Audited Repositories:</strong> Shipped systems and AI tools available on GitHub
              </div>
            </div>

            <div class="pt-2 flex items-center justify-between text-[11px] font-mono text-[#57534E]">
              <span>Status: Currently accepting select projects</span>
              <a href="/contact" class="font-bold text-[#1C1B19] hover:underline">Inquire for dates →</a>
            </div>
          </div>
        </SpiralNotebookCard>
      </div>

      <!-- Right: 3 Stacked Torn Paper Strips -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Strip 1: Semantic-NeuroOS -->
        <TornPaperStrip tilt="left" hasTape={true} class="relative paper-fold">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <Badge text="ON-DEVICE AI" variant="lavender" />
                <span class="text-xs font-mono text-[#57534E]">Semantic-NeuroOS</span>
              </div>
              <h4 class="text-base font-bold text-[#1C1B19] font-sans">
                Zero-Egress On-Device AI Agent Runner
              </h4>
              <p class="text-xs text-[#57534E] leading-relaxed">
                Spec sample demonstrating strict Linux Landlock LSM policies blocking socket creation (<code class="bg-[#F4F1EA] px-1 py-0.5 rounded text-[11px] font-mono">AF_INET = EACCES</code>). Mathematical isolation proving zero network egress at the kernel level.
              </p>
            </div>
            <div class="text-right shrink-0">
              <div class="text-sm font-bold font-mono text-[#1C1B19]">0 Bytes</div>
              <div class="text-[10px] text-[#57534E] font-mono">Network Egress</div>
            </div>
          </div>
        </TornPaperStrip>

        <!-- Strip 2: Agent-Radar -->
        <TornPaperStrip tilt="right" hasTape={true} class="relative paper-fold">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <Badge text="RUST / LINUX" variant="peach" />
                <span class="text-xs font-mono text-[#57534E]">Agent-Radar</span>
              </div>
              <h4 class="text-base font-bold text-[#1C1B19] font-sans">
                Real-Time Linux Kernel Ingestion Pipeline
              </h4>
              <p class="text-xs text-[#57534E] leading-relaxed">
                Replaced polling loops with kernel <code class="bg-[#F4F1EA] px-1 py-0.5 rounded text-[11px] font-mono">epoll_wait</code> and <code class="bg-[#F4F1EA] px-1 py-0.5 rounded text-[11px] font-mono">inotify</code>. Eliminates background CPU polling entirely, maintaining a flat 0.00% idle CPU footprint on developer workstations.
              </p>
            </div>
            <div class="text-right shrink-0">
              <div class="text-sm font-bold font-mono text-[#1C1B19]">0.00% CPU</div>
              <div class="text-[10px] text-[#57534E] font-mono">Idle Event Wait</div>
            </div>
          </div>
        </TornPaperStrip>

        <!-- Strip 3: UAV Traffic Analytics Research -->
        <TornPaperStrip tilt="left" hasTape={true} class="relative paper-fold">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <Badge text="COMPUTER VISION / UAV" variant="sage" />
                <span class="text-xs font-mono text-[#57534E]">NFU Taiwan Fellowship</span>
              </div>
              <h4 class="text-base font-bold text-[#1C1B19] font-sans">
                UAV Traffic-Analytics Prototype
              </h4>
              <p class="text-xs text-[#57534E] leading-relaxed">
                Engineered real-time aerial video inference using YOLO11n, ByteTrack, and SAHI (Slicing Aided Hyper Inference) for small-vehicle detection during the NFU Taiwan research fellowship.
              </p>
            </div>
            <div class="text-right shrink-0">
              <div class="text-sm font-bold font-mono text-[#1C1B19]">SAHI Tiling</div>
              <div class="text-[10px] text-[#57534E] font-mono">ByteTrack Matching</div>
            </div>
          </div>
        </TornPaperStrip>
      </div>
    </div>
  </section>

  <!-- Featured Flagship Work: Tilted Soft Paper Index Cards -->
  <section id="proof" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <SectionHeader
      eyebrow="FLAGSHIP PROOF // SAMPLE #0"
      title="Architecture-Backed Case Studies"
      subtitle="Explore how low-level systems engineering (epoll, Landlock, ternary integer weights) translates directly into high-converting developer collateral."
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {featuredWork.map((item, idx) => {
        const tilt = idx % 2 === 0 ? 'left' : 'right';
        const tape = idx % 3 === 0 ? 'lavender' : idx % 3 === 1 ? 'rose' : 'peach';
        const badgeVariants = ['lavender', 'peach', 'sage'] as const;
        const currentBadge = badgeVariants[idx % badgeVariants.length];

        return (
          <PaperCard
            tilt={tilt}
            hasTape={true}
            tapeColor={tape}
            class="p-6 sm:p-7 flex flex-col justify-between paper-fold"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-2">
                <Badge text={item.data.deliverableType} variant={currentBadge} />
                <span class="text-[11px] font-mono text-[#57534E]">
                  {item.data.readTime}
                </span>
              </div>

              <!-- Miniature Architectural SVG Preview with Warm Lines -->
              <div class="h-32 rounded-xl bg-[#F4F1EA]/70 border border-[#1C1B19]/10 flex items-center justify-center p-3 relative overflow-hidden">
                {idx === 0 && (
                  <svg class="w-full h-full" viewBox="0 0 280 90" fill="none">
                    <rect x="10" y="15" width="115" height="60" rx="8" fill="#FDFBF7" stroke="#1C1B19" stroke-opacity="0.2" stroke-width="1.5" stroke-dasharray="3 3"/>
                    <text x="20" y="32" fill="#57534E" font-size="8" font-family="monospace" font-weight="bold">BEFORE: VAGUE</text>
                    <text x="20" y="48" fill="#57534E" font-size="7" font-family="monospace">All-in-one platform...</text>
                    <path d="M130 45 H 150" stroke="#1C1B19" stroke-width="2"/>
                    <rect x="155" y="15" width="115" height="60" rx="8" fill="#D7F0DE" stroke="#1C1B19" stroke-opacity="0.2" stroke-width="1.5"/>
                    <text x="165" y="32" fill="#1C1B19" font-size="8" font-family="monospace" font-weight="bold">AFTER: CONVERTED</text>
                    <text x="165" y="48" fill="#1C1B19" font-size="7" font-family="monospace" font-weight="bold">Firecracker (0% Idle)</text>
                  </svg>
                )}
                {idx === 1 && (
                  <svg class="w-full h-full" viewBox="0 0 280 90" fill="none">
                    <rect x="10" y="20" width="70" height="50" rx="6" fill="#FDFBF7" stroke="#1C1B19" stroke-opacity="0.2" stroke-width="1.5"/>
                    <text x="18" y="38" fill="#1C1B19" font-size="8" font-family="monospace" font-weight="bold">inotify</text>
                    <path d="M85 45 H 105" stroke="#1C1B19" stroke-width="1.5"/>
                    <rect x="110" y="20" width="70" height="50" rx="6" fill="#FDFBF7" stroke="#1C1B19" stroke-opacity="0.2" stroke-width="1.5"/>
                    <text x="118" y="38" fill="#1C1B19" font-size="8" font-family="monospace" font-weight="bold">epoll_wait</text>
                    <path d="M185 45 H 205" stroke="#1C1B19" stroke-width="1.5"/>
                    <rect x="210" y="20" width="60" height="50" rx="6" fill="#E3DEFA" stroke="#1C1B19" stroke-opacity="0.2" stroke-width="1.5"/>
                    <text x="218" y="38" fill="#1C1B19" font-size="8" font-family="monospace" font-weight="bold">0.00% CPU</text>
                  </svg>
                )}
                {idx === 2 && (
                  <svg class="w-full h-full" viewBox="0 0 280 90" fill="none">
                    <rect x="15" y="15" width="250" height="60" rx="8" fill="#FDFBF7" stroke="#1C1B19" stroke-opacity="0.2" stroke-width="1.5"/>
                    <text x="25" y="32" fill="#1C1B19" font-size="8" font-family="monospace" font-weight="bold">LANDLOCK LSM BOUNDARY</text>
                    <rect x="25" y="40" width="105" height="25" rx="4" fill="#F4F1EA" stroke="#1C1B19" stroke-opacity="0.15" stroke-width="1"/>
                    <text x="32" y="55" fill="#1C1B19" font-size="7" font-family="monospace" font-weight="bold">BitNet 1.58b</text>
                    <rect x="145" y="40" width="110" height="25" rx="4" fill="#FADEC9" stroke="#1C1B19" stroke-opacity="0.15" stroke-width="1"/>
                    <text x="152" y="55" fill="#1C1B19" font-size="7" font-family="monospace" font-weight="bold">AF_INET = EACCES</text>
                  </svg>
                )}
              </div>

              <div>
                <h3 class="text-lg font-bold font-sans tracking-tight text-[#1C1B19] group-hover:text-[#3D3A36] transition-colors leading-snug">
                  {item.data.title}
                </h3>
                <p class="text-[#57534E] text-xs mt-2 leading-relaxed font-sans line-clamp-3">
                  {item.data.tagline}
                </p>
              </div>

              <div class="text-[11px] font-mono text-[#1C1B19] bg-[#F4F1EA] p-2.5 rounded-xl border border-[#1C1B19]/8">
                <span class="text-[#57534E] font-medium">Target Buyer: </span>
                <span class="text-[#1C1B19] font-bold">{item.data.targetBuyer}</span>
              </div>

              <div class="grid grid-cols-2 gap-2 font-mono text-xs pt-1">
                {item.data.metrics.slice(0, 2).map(m => (
                  <div class="bg-[#FDFBF7] p-2 rounded-xl border border-[#1C1B19]/10">
                    <div class="text-[10px] text-[#57534E]">{m.label}</div>
                    <div class="text-[#1C1B19] font-bold text-xs mt-0.5">{m.value}</div>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-5 mt-4 border-t border-[#1C1B19]/8 flex items-center justify-between">
              <span class="text-[10px] font-mono text-[#57534E]">
                {item.data.stack[0]} • {item.data.stack[1]}
              </span>
              <a
                href={`/work/${item.id}`}
                class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold text-[#1C1B19] hover:underline"
              >
                <span>Read Case Study</span>
                <ArrowUpRight className="w-3.5 h-3.5 text-[#1C1B19]" />
              </a>
            </div>
          </PaperCard>
        );
      })}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/work"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-sans font-semibold tracking-wide bg-[#FDFBF7] border border-[#1C1B19]/15 text-[#1C1B19] hover:bg-[#F4F1EA] shadow-paper-sm hover:translate-y-[-1px] transition-all"
      >
        <span>View All 5 Production Artifacts</span>
        <ArrowRight className="w-3.5 h-3.5 text-[#1C1B19]" />
      </a>
    </div>
  </section>

  <!-- The 70/30 Research-First Pipeline (3-Step Numbered Paper Dossier Cards) -->
  <section class="border-t border-[#1C1B19]/8 bg-[#F4F1EA]/60 py-20 sm:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeader
        eyebrow="METHODOLOGY & RIGOUR"
        title="The 70/30 Research-First Pipeline"
        subtitle="70% of high-converting technical copy is determined before opening an editor. We deconstruct kernel code, mine developer objections, and map mechanisms to commercial benefits."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
        {/* Step 1 */}
        <div class="bg-[#FDFBF7] rounded-2xl p-6 sm:p-7 border border-[#1C1B19]/10 shadow-paper-md space-y-4 relative paper-fold">
          <div class="masking-tape masking-tape-rose -top-3"></div>
          <div class="flex items-center justify-between">
            <span class="text-3xl font-bold font-sans text-[#1C1B19]">01</span>
            <Badge text="70% OF THE WORK" variant="rose" />
          </div>
          <h3 class="text-lg font-bold font-sans tracking-tight text-[#1C1B19]">
            Product Teardown & VoC Mining
          </h3>
          <p class="text-[#57534E] text-xs sm:text-sm leading-relaxed font-sans">
            I clone your repo, run your CLI, inspect your AST, and mine 100+ raw developer objections across Hacker News, GitHub Issues, and Reddit to pinpoint exact conversion friction points.
          </p>
          <div class="pt-2 text-xs font-mono text-[#57534E] border-t border-[#1C1B19]/8 space-y-1">
            <div>• GitHub code inspection</div>
            <div>• VoC objection extraction</div>
            <div>• Competitor positioning gap audit</div>
          </div>
