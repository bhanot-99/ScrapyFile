---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ContactForm from '../components/interactive/ContactForm.tsx';
import CopyEmailButton from '../components/ui/CopyEmailButton.tsx';
import { Clock, Globe, ShieldCheck, GitBranch } from 'lucide-react';
---

<BaseLayout
  title="Contact // Start a Project with Jatin Bhanot"
  description="Direct inquiry channel for Technical Copywriting, Developer Landing Page Rewrites, and Technical Whitepapers."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-24">
    <SectionHeader
      eyebrow="COMMENCE PROJECT INQUIRY"
      title="Let's Build Developer Trust."
      subtitle="Whether you need a high-converting developer homepage rewrite, a code-backed deep dive, or a 2-minute video teardown—reach out below."
    />

    <!-- Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Direct Contacts & SLAs -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-[#FDFBF7] rounded-2xl p-6 sm:p-8 border border-[#1C1B19]/10 shadow-paper-md space-y-6 relative">
          <div class="masking-tape masking-tape-lavender -top-3"></div>
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-[#57534E] font-semibold block mb-2">
              // DIRECT TRANSMISSION
            </span>
            <h3 class="text-xl font-bold font-sans tracking-tight text-[#1C1B19] mb-2">
              Direct Engineering Inquiries
            </h3>
            <p class="text-[#57534E] text-xs sm:text-sm leading-relaxed font-sans">
              No sales intermediaries. Your message goes directly to Jatin's personal workstation inbox.
            </p>
          </div>

          <!-- Email Copy Card -->
          <div class="p-4 rounded-xl bg-[#F4F1EA] border border-[#1C1B19]/8 space-y-2">
            <span class="text-[11px] font-mono text-[#57534E] uppercase tracking-wider font-semibold block">
              Primary Work Email:
            </span>
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm text-[#1C1B19] font-bold">bhanot1054@gmail.com</span>
              <CopyEmailButton client:load email="bhanot1054@gmail.com" label="Copy" />
            </div>
          </div>

          <!-- Operational SLAs -->
          <div class="space-y-3 pt-2 border-t border-[#1C1B19]/8 font-mono text-xs">
            <div class="flex items-start gap-3 text-[#1C1B19]">
              <Clock className="w-4 h-4 text-[#1C1B19] shrink-0 mt-0.5" />
              <div>
                <strong class="font-semibold">Response Time SLA: </strong>
                <span class="text-[#57534E]">Guaranteed &lt; 24 hours (usually under 4h).</span>
              </div>
            </div>

            <div class="flex items-start gap-3 text-[#1C1B19]">
              <Globe className="w-4 h-4 text-[#1C1B19] shrink-0 mt-0.5" />
              <div>
                <strong class="font-semibold">Timezone Flexibility: </strong>
                <span class="text-[#57534E]">IST (UTC+5:30) • Seamless daily overlap with US East & EU business hours.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 text-[#1C1B19]">
              <ShieldCheck className="w-4 h-4 text-[#1C1B19] shrink-0 mt-0.5" />
              <div>
                <strong class="font-semibold">Current Availability: </strong>
                <span class="text-[#1C1B19] font-bold bg-[#D7F0DE] px-2 py-0.5 rounded-full text-[11px]">Q4 / 2026: 2 Slots Open</span>
              </div>
            </div>
          </div>

          <!-- Links -->
          <div class="pt-4 border-t border-[#1C1B19]/8 flex items-center gap-4 text-xs font-mono font-semibold">
            <a
              href="https://github.com/bhanot1054"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[#1C1B19] hover:underline"
            >
              <GitBranch className="w-3.5 h-3.5 text-[#1C1B19]" />
              <span>GitHub</span>
            </a>
            <span class="text-[#1C1B19]/30">•</span>
            <a
              href="https://linkedin.com/in/jatin-bhanot"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[#1C1B19] hover:underline"
            >
              <svg class="w-3.5 h-3.5 text-[#1C1B19]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.46 1.46 0 1 0 0-2.92 1.46 1.46 0 0 0 0 2.92m1.4 9.74v-8.37H5.06v8.37h2.8z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        {/* Free Teardown Banner */}
        <div class="p-6 rounded-2xl bg-[#E3DEFA] border border-[#1C1B19]/10 shadow-paper-md text-xs font-sans space-y-2 relative">
          <div class="masking-tape masking-tape-peach -top-3"></div>
          <span class="text-[#1C1B19] font-bold tracking-tight block text-sm">
            ⚡ Want a 2-Minute Homepage Teardown?
          </span>
          <p class="text-[#57534E] leading-relaxed">
            Send your URL in the project brief on the right. I will record a private, hyper-specific Loom breaking down where your messaging leaks developer trust. Free, no spam.
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Validated Inquiry Form -->
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</BaseLayout>