---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CopyEmailButton from '../components/ui/CopyEmailButton.tsx';
import PaperCard from '../components/ui/PaperCard.astro';
import { GraduationCap, ArrowRight } from 'lucide-react';

const techStack = {
  systems: {
    category: 'Systems, Kernel & Concurrency',
    summary: 'Low-level Linux systems programming, unprivileged kernel sandboxing, and deterministic async runtimes.',
    skills: [
      { name: 'Rust (tokio, nix, ratatui, aya)', proof: 'Production daemons, zero-allocation ring buffers' },
      { name: 'C++20 (Concepts, Coroutines, SIMD)', proof: 'AVX-512 vector kernels, DMA-BUF ingestion' },
      { name: 'Linux Kernel Internals', proof: 'epoll, inotify, /proc, Landlock LSM, seccomp-bpf' },
      { name: 'Concurrency & Memory', proof: 'Lock-free ring buffers, cache-line alignment' }
    ]
  },
  ai: {
    category: 'On-Device, Edge AI & Quantization',
    summary: 'Air-gapped language model runtimes, ternary integer weights, and real-time UAV computer vision.',
    skills: [
      { name: 'BitNet b1.58 Ternary Architecture', proof: 'Addition-only matrix kernels on AVX-512' },
      { name: 'Llama.cpp & GGUF Quantization', proof: 'CPU inference optimization, Q4_K_M kernels' },
      { name: 'Edge Vision Avionics (YOLOv8, TensorRT)', proof: 'Sub-4ms tracking on Jetson & ARM Cortex' },
      { name: 'Zero-Egress Security Boundaries', proof: 'Mathematical network drops via Linux Landlock' }
    ]
  },
  observability: {
    category: 'Data, Telemetry & Developer Marketing',
    summary: 'High-throughput telemetry correlation, wireframed developer conversion funnels, and technical communication.',
    skills: [
      { name: 'OpenTelemetry (OTel) & Linux Perf', proof: 'Sub-microsecond trace spans and RSS auditing' },
      { name: 'Developer Copywriting & VoC Mining', proof: 'Reverse-engineering developer objections from HN/Reddit' },
      { name: 'Interactive Documentation (MDX / Astro)', proof: 'Expressive Code, IDE-grade diff blocks' },
      { name: 'Technical Product Launches', proof: 'Ranked #2 on Hacker News Show HN' }
    ]
  }
};
---

<BaseLayout
  title="About // Jatin Bhanot (Systems Engineer & Technical Copywriter)"
  description="Background, engineering narrative, and technical stack matrix for Jatin Bhanot (Rust, C++20, Linux Kernel, Edge AI)."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-24">
    <!-- Header Narrative -->
    <div class="max-w-3xl mb-16 space-y-6">
      <SectionHeader
        eyebrow="ENGINEERING NARRATIVE"
        title="Why A Systems Engineer Writes Sharper Developer Copy"
      />

      <div class="text-[#3F3E3B] text-base sm:text-lg leading-relaxed space-y-5 font-sans font-medium">
        <p>
          I am <strong>Jatin Bhanot</strong>, a Computer Science engineer specialising in <span class="highlight-yellow font-bold text-[#111111]">Rust, C++20, Linux kernel internals, and on-device AI architectures</span>.
        </p>

        <p>
          Most technical marketing fails because it is outsourced to freelance generalists or prompt-engineered LLMs. The result is bloated, superficial copy that says <em>"empower modern teams with seamless intelligent workflows."</em> Senior Staff Engineers and cynical CTOs see right through it. They don't want buzzwords—they want to know how your software handles PID-reuse races, memory bus contention, and cold-start latency.
        </p>

        <p>
          Because I write production systems myself, I don't read marketing briefs; I read your <strong>source code, your GitHub PRs, and your benchmark suites</strong>. I translate low-level mechanisms into undeniable commercial value that engineers actually respect.
        </p>
      </div>

      <div class="pt-4 flex flex-wrap items-center gap-4">
        <CopyEmailButton client:load email="bhanot1054@gmail.com" label="bhanot1054@gmail.com" />
        <a
          href="/work"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-bold uppercase text-[#111111] hover:text-[#FF3B30] underline decoration-2 decoration-[#111111]"
        >
          <span>Inspect Case Studies</span>
          <ArrowRight className="w-3.5 h-3.5 text-[#FF3B30]" />
        </a>
      </div>
    </div>

    <!-- Educational & Research Pedigree -->
    <div class="mb-20 bg-[#FFFDF9] rounded-sm p-6 sm:p-8 border-[2px] border-[#111111] shadow-[5px_5px_0px_#111111] space-y-6 relative">
      <div class="washi-tape washi-tape-yellow"></div>
      <div class="flex items-center gap-2">
        <GraduationCap className="w-5 h-5 text-[#2563EB]" />
        <h3 class="text-lg font-black font-display uppercase tracking-tight text-[#111111]">
          Academic & International Research Pedigree
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-xs">
        <div class="p-4 rounded-xs bg-[#FAF8F3] border-[1.5px] border-[#111111] shadow-[2.5px_2.5px_0px_#111111] space-y-2">
          <div class="text-[#2563EB] font-bold text-sm">Chitkara University</div>
          <div class="text-[#111111] font-bold">B.E. Computer Science Engineering</div>
          <div class="text-[#4B4A47] font-medium font-sans">Specialisation in Systems, Concurrency & Operating Systems Architecture</div>
        </div>

        <div class="p-4 rounded-xs bg-[#FAF8F3] border-[1.5px] border-[#111111] shadow-[2.5px_2.5px_0px_#111111] space-y-2">
          <div class="text-[#FF3B30] font-bold text-sm">National Formosa University (Taiwan)</div>
          <div class="text-[#111111] font-bold">UAV Edge AI & Computer Vision Internship</div>
          <div class="text-[#4B4A47] font-medium font-sans">Engineered sub-4ms real-time tracking pipelines on ARM Jetson avionics</div>
        </div>

        <div class="p-4 rounded-xs bg-[#FAF8F3] border-[1.5px] border-[#111111] shadow-[2.5px_2.5px_0px_#111111] space-y-2">
          <div class="text-[#16A34A] font-bold text-sm">Astana IT University</div>
          <div class="text-[#111111] font-bold">Applied CS & Cloud Systems Exchange</div>
          <div class="text-[#4B4A47] font-medium font-sans">Distributed microservices, Linux namespaces, and low-latency networking</div>
        </div>
      </div>
    </div>

    <!-- Structured Technical Stack Matrix -->
    <div class="space-y-8">
      <div class="border-b-[2px] border-[#111111] pb-4">
        <span class="text-xs font-mono uppercase tracking-[0.16em] text-[#FF3B30] font-bold block mb-2">
          // AUDITED CAPABILITIES
        </span>
        <h2 class="text-2xl sm:text-3xl font-black font-display uppercase tracking-tight text-[#111111]">
          Structured Technical Stack Matrix
        </h2>
        <p class="text-[#4B4A47] text-sm mt-1 font-medium font-sans">
          Every skill listed is backed by shipped code, automated test suites, or live benchmarks.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {Object.values(techStack).map((cat) => (
          <PaperCard
            class="p-6 sm:p-7 space-y-5"
          >
            <div>
              <h3 class="text-lg font-black font-display uppercase tracking-tight text-[#111111]">
                {cat.category}
              </h3>
              <p class="text-[#4B4A47] text-xs mt-1 leading-relaxed font-sans font-medium">
                {cat.summary}
              </p>
            </div>

            <div class="space-y-3 pt-2 border-t-[1.5px] border-[#111111]/20 font-mono text-xs">
              {cat.skills.map(skill => (
                <div class="p-3 rounded-xs bg-[#FAF8F3] border-[1.5px] border-[#111111] shadow-[2px_2px_0px_#111111] space-y-1">
                  <div class="text-[#111111] font-bold">{skill.name}</div>
                  <div class="text-[11px] text-[#4B4A47] leading-snug font-sans">{skill.proof}</div>
                </div>
              ))}
            </div>
          </PaperCard>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
