---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CopyEmailButton from '../components/ui/CopyEmailButton.tsx';
import PaperCard from '../components/ui/PaperCard.astro';
import Badge from '../components/ui/Badge.astro';
import { GraduationCap, ArrowRight } from 'lucide-react';

const techStack = {
  systems: {
    category: 'Systems, Kernel & Concurrency',
    badgeVariant: 'lavender' as const,
    summary: 'Low-level Linux systems programming, unprivileged kernel sandboxing, and deterministic async runtimes.',
    skills: [
      { name: 'Rust (tokio, nix, ratatui, aya)', proof: 'Production daemons, zero-allocation event handling' },
      { name: 'C++20 (Concepts, Coroutines, SIMD)', proof: 'SIMD vector routines, clean systems architecture' },
      { name: 'Linux Kernel Internals', proof: 'epoll, inotify, /proc, Landlock LSM, seccomp-bpf' },
      { name: 'Concurrency & Memory', proof: 'LRU caches with TTL eviction, cache-line alignment' }
    ]
  },
  ai: {
    category: 'On-Device, Edge AI & Computer Vision',
    badgeVariant: 'peach' as const,
    summary: 'Local language model isolation, ternary weight architectures, and real-time UAV computer vision.',
    skills: [
      { name: 'BitNet b1.58 Ternary Architecture', proof: 'Addition-only matrix kernels on CPU architectures' },
      { name: 'Llama.cpp & GGUF Quantization', proof: 'CPU inference analysis, Q4_K_M kernel comparisons' },
      { name: 'UAV Aerial Vision (YOLO11n, ByteTrack, SAHI)', proof: 'Small-vehicle tracking across high-resolution aerial video' },
      { name: 'Zero-Egress Security Boundaries', proof: 'Network socket restriction via Linux Landlock' }
    ]
  },
  observability: {
    category: 'Telemetry, Tooling & Developer Marketing',
    badgeVariant: 'sage' as const,
    summary: 'Low-overhead telemetry correlation, wireframed developer conversion funnels, and technical communication.',
    skills: [
      { name: 'OpenTelemetry (OTel) & Linux Perf', proof: 'Low-overhead trace spans and RSS memory profiling' },
      { name: 'Developer Copywriting & VoC Mining', proof: 'Reverse-engineering developer objections from HN/Reddit' },
      { name: 'Interactive Documentation (MDX / Astro)', proof: 'Expressive Code, IDE-grade diff blocks' },
      { name: 'Technical Product Launches', proof: 'High-signal release notes, CLI quickstarts, and Show HN positioning' }
    ]
  }
};
---

<BaseLayout
  title="About // Jatin Bhanot (Systems Engineer & Technical Copywriter)"
  description="Background, engineering narrative, and technical stack matrix for Jatin Bhanot (Rust, C++20, Linux Kernel, Edge AI)."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-24">
    <!-- Header Narrative -->
    <div class="max-w-3xl mb-16 space-y-6">
      <SectionHeader
        eyebrow="ENGINEERING NARRATIVE"
        title="Why A Systems Engineer Writes Sharper Developer Copy"
      />

      <div class="text-[#57534E] text-base sm:text-lg leading-relaxed space-y-5 font-sans">
        <p>
          I am <strong class="text-[#1C1B19]">Jatin Bhanot</strong>, a Computer Science engineer specialising in <span class="bg-[#E3DEFA] px-2 py-0.5 rounded-lg font-semibold text-[#1C1B19]">Rust, C++20, Linux kernel internals, and on-device AI architectures</span>.
        </p>

        <p>
          Most technical marketing fails because it is outsourced to freelance generalists or prompt-engineered LLMs. The result is bloated, superficial copy that says <em>"empower modern teams with seamless intelligent workflows."</em> Senior Staff Engineers and cynical CTOs see right through it. They don't want buzzwords—they want to know how your software handles PID-reuse races, memory bus contention, and cold-start latency.
        </p>

        <p>
          Because I write production systems myself, I don't read marketing briefs; I read your <strong class="text-[#1C1B19]">source code, your GitHub PRs, and your benchmark suites</strong>. I translate low-level mechanisms into undeniable commercial value that engineers actually respect.
        </p>
      </div>

      <div class="pt-4 flex flex-wrap items-center gap-4">
        <CopyEmailButton client:load email="bhanot1054@gmail.com" label="bhanot1054@gmail.com" />
        <a
          href="/work"
          class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold text-[#1C1B19] hover:underline"
        >
          <span>Inspect Case Studies</span>
          <ArrowRight className="w-3.5 h-3.5 text-[#1C1B19]" />
        </a>
      </div>
    </div>

    <!-- Educational & Research Pedigree -->
    <div class="mb-20 bg-[#FDFBF7] rounded-2xl p-6 sm:p-8 border border-[#1C1B19]/10 shadow-paper-md space-y-6 relative">
      <div class="masking-tape masking-tape-peach -top-3"></div>
      <div class="flex items-center gap-2.5">
        <GraduationCap className="w-5 h-5 text-[#1C1B19]" />
        <h3 class="text-lg font-bold font-sans tracking-tight text-[#1C1B19]">
          Academic & International Research Pedigree
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-xs">
        <div class="p-4 rounded-xl bg-[#F4F1EA] border border-[#1C1B19]/8 space-y-2">
          <div class="text-[#1C1B19] font-bold text-sm">Chitkara University</div>
          <div class="text-[#1C1B19] font-semibold">B.E. Computer Science Engineering</div>
          <div class="text-[#57534E] font-sans">Specialisation in Systems, Concurrency & Operating Systems Architecture</div>
        </div>

        <div class="p-4 rounded-xl bg-[#F4F1EA] border border-[#1C1B19]/8 space-y-2">
          <div class="text-[#1C1B19] font-bold text-sm">National Formosa University (Taiwan)</div>
          <div class="text-[#1C1B19] font-semibold">UAV Computer Vision Research Fellowship</div>
          <div class="text-[#57534E] font-sans">Engineered real-time aerial video inference using YOLO11n, ByteTrack, and SAHI for vehicle tracking</div>
        </div>

        <div class="p-4 rounded-xl bg-[#F4F1EA] border border-[#1C1B19]/8 space-y-2">
          <div class="text-[#1C1B19] font-bold text-sm">Astana IT University</div>
          <div class="text-[#1C1B19] font-semibold">Applied CS & Cloud Systems Exchange</div>
          <div class="text-[#57534E] font-sans">Distributed microservices, Linux namespaces, and low-latency networking</div>
        </div>
      </div>
    </div>

    <!-- Structured Technical Stack Matrix -->
    <div class="space-y-8">
      <div class="border-b border-[#1C1B19]/8 pb-4">
        <span class="text-xs font-mono uppercase tracking-wider text-[#57534E] font-semibold block mb-2">
          // SYSTEMS CAPABILITIES
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold font-sans tracking-tight text-[#1C1B19]">
          Structured Technical Stack Matrix
        </h2>
        <p class="text-[#57534E] text-sm mt-1 font-sans">
          Every capability is backed by runnable code, automated test suites, or reproducible benchmarks.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {Object.values(techStack).map((cat) => (
          <PaperCard
            class="p-6 sm:p-7 space-y-5"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <Badge text="SHIPPED / VERIFIED" variant={cat.badgeVariant} />
              </div>
              <h3 class="text-lg font-bold font-sans tracking-tight text-[#1C1B19]">
                {cat.category}
              </h3>
              <p class="text-[#57534E] text-xs mt-1.5 leading-relaxed font-sans">
                {cat.summary}
              </p>
            </div>

            <div class="space-y-3 pt-3 border-t border-[#1C1B19]/8 font-mono text-xs">
              {cat.skills.map(skill => (
                <div class="p-3 rounded-xl bg-[#F4F1EA] border border-[#1C1B19]/8 space-y-1">
                  <div class="text-[#1C1B19] font-semibold">{skill.name}</div>
                  <div class="text-[11px] text-[#57534E] leading-snug font-sans">{skill.proof}</div>
                </div>
              ))}
            </div>
          </PaperCard>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>