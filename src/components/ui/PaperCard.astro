---
interface Props {
  tilt?: 'none' | 'left' | 'right';
  hasTape?: boolean;
  tapeColor?: 'default' | 'peach' | 'lavender' | 'rose';
  class?: string;
}

const {
  tilt = 'none',
  hasTape = true,
  tapeColor = 'default',
  class: className = '',
} = Astro.props;

const tiltClasses = {
  none: '',
  left: 'tilt-gentle-left',
  right: 'tilt-gentle-right',
};

const tapeColorClass = {
  default: '',
  peach: 'masking-tape-peach',
  lavender: 'masking-tape-lavender',
  rose: 'masking-tape-rose',
}[tapeColor];
---

<div class={`relative bg-[#FDFBF7] rounded-2xl border border-[#1C1B19]/8 shadow-paper-md transition-all duration-300 hover:shadow-paper-lg ${tiltClasses[tilt]} ${className}`}>
  {hasTape && (
    <div class={`masking-tape ${tapeColorClass}`}></div>
  )}
  <slot />
</div>
