---
interface Props {
  type: 'arrow-curved' | 'star-sketch' | 'squiggly-underline' | 'emphasis-lines' | 'bezier-dot';
  class?: string;
  color?: string;
  width?: number;
  height?: number;
}

const {
  type,
  class: className = '',
  color = '#1C1B19',
  width = 60,
  height = 30,
} = Astro.props;
---

{type === 'arrow-curved' && (
  <svg class={className} width={width} height={height} viewBox="0 0 90 40" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 32C24 36 58 32 78 12" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M68 8L82 10L77 22" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{type === 'star-sketch' && (
  <svg class={className} width={width} height={height} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2L14.8 8.5L22 9.2L16.6 14.1L18.2 21.2L12 17.5L5.8 21.2L7.4 14.1L2 9.2L9.2 8.5L12 2Z" stroke={color} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{type === 'squiggly-underline' && (
  <svg class={className} width={width} height={height} viewBox="0 0 120 12" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 6C15 2 25 10 38 6C51 2 61 10 74 6C87 2 97 10 110 6C114 4 117 5 118 6" stroke={color} stroke-width="2.5" stroke-linecap="round"/>
  </svg>
)}

{type === 'emphasis-lines' && (
  <svg class={className} width={width} height={height} viewBox="0 0 30 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 16L12 4M14 18L22 6M24 16L28 8" stroke={color} stroke-width="2" stroke-linecap="round"/>
  </svg>
)}

{type === 'bezier-dot' && (
  <svg class={className} width={width} height={height} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="20" cy="20" r="4" fill={color}/>
    <path d="M8 20H32M20 8V32" stroke={color} stroke-width="1.5" stroke-dasharray="2 2"/>
  </svg>
)}
