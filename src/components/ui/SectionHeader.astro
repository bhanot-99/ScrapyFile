---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---

<div class={`mb-10 sm:mb-14 ${align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-3xl'}`}>
  <!-- Eyebrow Stamp Pill -->
  <div class={`inline-flex items-center gap-2 mb-3 bg-[#FFE600] border-[1.5px] border-[#111111] px-2.5 py-0.5 rounded-sm shadow-[2px_2px_0px_#111111]`}>
    <span class="w-2 h-2 rounded-full bg-[#111111]"></span>
    <span class="text-[11px] uppercase tracking-[0.16em] text-[#111111] font-mono font-extrabold">
      {eyebrow}
    </span>
  </div>

  <!-- Ultra-wide Chunky Poster Title -->
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-[-0.04em] text-[#111111] font-display leading-[1.05] mb-4">
    {title}
  </h2>

  {subtitle && (
    <p class="text-[#4B4A47] text-sm sm:text-base leading-relaxed font-sans font-medium">
      {subtitle}
    </p>
  )}
</div>
