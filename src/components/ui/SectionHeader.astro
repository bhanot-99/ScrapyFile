---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---

<div class={`mb-10 sm:mb-14 ${align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-3xl'}`}>
  <div class="flex items-center gap-2 mb-3">
    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span class="text-xs uppercase tracking-[0.18em] text-emerald-400/90 font-mono font-medium">
      {eyebrow}
    </span>
  </div>
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white mb-4">
    {title}
  </h2>
  {subtitle && (
    <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
