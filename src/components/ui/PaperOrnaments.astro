---
interface Props {
  type: 'star' | 'sparkle' | 'asterisk' | 'arrow-curved' | 'arrow-scribble' | 'stamp-box';
  class?: string;
  color?: string;
  size?: number;
}

const { type, class: className = '', color = 'currentColor', size = 20 } = Astro.props;
---

{type === 'star' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill={color} xmlns="http://www.w3.org/2000/svg">
    <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
  </svg>
)}

{type === 'sparkle' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2V22M2 12H22M4.93 4.93L19.07 19.07M4.93 19.07L19.07 4.93" />
    <circle cx="12" cy="12" r="3" fill={color} />
  </svg>
)}

{type === 'asterisk' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill={color} xmlns="http://www.w3.org/2000/svg">
    <path d="M10.5 0H13.5V8.5L19.5 2.5L21.5 4.5L15.5 10.5H24V13.5H15.5L21.5 19.5L19.5 21.5L13.5 15.5V24H10.5V15.5L4.5 21.5L2.5 19.5L8.5 13.5H0V10.5H8.5L2.5 4.5L4.5 2.5L10.5 8.5V0Z" />
  </svg>
)}

{type === 'arrow-curved' && (
  <svg class={className} width={size * 2} height={size} viewBox="0 0 80 40" fill="none" stroke={color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
    <path d="M5 32C25 35 55 30 72 12" />
    <path d="M62 8L74 11L72 23" />
  </svg>
)}

{type === 'arrow-scribble' && (
  <svg class={className} width={size * 1.5} height={size} viewBox="0 0 60 30" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 18C15 12 28 8 40 14C45 16 52 18 55 12" />
    <path d="M48 7L56 12L50 19" />
  </svg>
)}

{type === 'stamp-box' && (
  <div class={`inline-block border-2 border-dashed border-[#111111] px-2 py-0.5 rounded font-mono font-bold text-[10px] tracking-widest uppercase rotate-[-2deg] ${className}`}>
    <slot />
  </div>
)}
