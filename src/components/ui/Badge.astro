---
interface Props {
  text: string;
  variant?: 'lavender' | 'peach' | 'rose' | 'lime' | 'sage' | 'kraft' | 'tactical' | 'neutral' | 'accent' | 'warning' | 'danger' | 'yellow' | 'violet';
  size?: 'xs' | 'sm';
}

const { text, variant = 'lavender', size = 'xs' } = Astro.props;

const variantStyles: Record<string, string> = {
  lavender: 'bg-[#E3DEFA] text-[#1C1B19] border-[#1C1B19]/10',
  peach: 'bg-[#FADEC9] text-[#1C1B19] border-[#1C1B19]/10',
  rose: 'bg-[#F7D6DE] text-[#1C1B19] border-[#1C1B19]/10',
  lime: 'bg-[#EAF57A] text-[#1C1B19] border-[#1C1B19]/10',
  sage: 'bg-[#D7F0DE] text-[#1C1B19] border-[#1C1B19]/10',
  kraft: 'bg-[#E6E0D5] text-[#1C1B19] border-[#1C1B19]/10',
  tactical: 'bg-[#D7F0DE] text-[#1C1B19] border-[#1C1B19]/10',
  neutral: 'bg-[#FDFBF7] text-[#1C1B19] border-[#1C1B19]/10',
  accent: 'bg-[#E3DEFA] text-[#1C1B19] border-[#1C1B19]/10',
  warning: 'bg-[#FADEC9] text-[#1C1B19] border-[#1C1B19]/10',
  danger: 'bg-[#F7D6DE] text-[#1C1B19] border-[#1C1B19]/10',
  yellow: 'bg-[#EAF57A] text-[#1C1B19] border-[#1C1B19]/10',
  violet: 'bg-[#E3DEFA] text-[#1C1B19] border-[#1C1B19]/10',
};

const sizeStyles = {
  xs: 'text-[11px] px-2.5 py-0.5 shadow-sm',
  sm: 'text-xs px-3 py-1 shadow-sm',
};
---

<span class={`inline-flex items-center font-mono font-semibold rounded-full border ${variantStyles[variant] || variantStyles.lavender} ${sizeStyles[size]} tracking-wide`}>
  {text}
</span>
