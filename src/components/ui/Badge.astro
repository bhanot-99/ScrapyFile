---
interface Props {
  text: string;
  variant?: 'tactical' | 'neutral' | 'accent' | 'warning' | 'danger' | 'yellow' | 'violet';
  size?: 'xs' | 'sm';
}

const { text, variant = 'tactical', size = 'xs' } = Astro.props;

const variantStyles = {
  tactical: 'bg-[#16A34A] text-white border-[#111111]',
  neutral: 'bg-white text-[#111111] border-[#111111]',
  accent: 'bg-[#2563EB] text-white border-[#111111]',
  warning: 'bg-[#FFE600] text-[#111111] border-[#111111]',
  danger: 'bg-[#FF3B30] text-white border-[#111111]',
  yellow: 'bg-[#FFE600] text-[#111111] border-[#111111]',
  violet: 'bg-[#7C3AED] text-white border-[#111111]',
};

const sizeStyles = {
  xs: 'text-[10px] px-2 py-0.5 shadow-[1.5px_1.5px_0px_#111111]',
  sm: 'text-xs px-2.5 py-1 shadow-[2px_2px_0px_#111111]',
};
---

<span class={`inline-flex items-center font-mono font-bold rounded-sm border-[1.5px] ${variantStyles[variant]} ${sizeStyles[size]} tracking-wider uppercase`}>
  {text}
</span>
