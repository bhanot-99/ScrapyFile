---
interface Props {
  currentPath?: string;
}

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 w-full px-4 sm:px-6 pt-3 pb-2 transition-all duration-200">
  <div class="max-w-6xl mx-auto glass-panel rounded-xl px-4 sm:px-6 py-3 flex items-center justify-between border border-white/10 shadow-2xl shadow-black/80">
    <!-- Brand Monogram -->
    <a href="/" class="group flex items-center gap-2.5 font-mono text-xs sm:text-sm tracking-tight text-zinc-200 hover:text-white transition-colors">
      <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold group-hover:border-emerald-400 transition-colors">
        JB
      </span>
      <span class="font-semibold text-zinc-100">JATIN BHANOT</span>
      <span class="text-zinc-600 hidden sm:inline">//</span>
      <span class="text-emerald-400/90 font-mono text-xs tracking-wider hidden sm:inline">TECH COPY</span>
    </a>

    <!-- Center Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs tracking-wide">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-md transition-all ${
              isActive
                ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 font-medium'
                : 'text-zinc-400 hover:text-zinc-100 hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Availability Status & Project CTA -->
    <div class="flex items-center gap-3">
      <div class="hidden lg:flex items-center gap-2 px-2.5 py-1 rounded-full bg-zinc-900/90 border border-emerald-500/20 text-[11px] font-mono text-zinc-300">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Q4 / 2026: <strong class="text-emerald-400 font-normal">2 Slots Open</strong></span>
      </div>

      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium tracking-wide bg-emerald-500 text-black hover:bg-emerald-400 transition-all glow-tactical hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>Start Project</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile Secondary Sub-Nav Bar -->
  <div class="flex md:hidden justify-center gap-2 mt-2 px-2">
    <div class="glass-panel px-3 py-1 rounded-lg flex items-center gap-2 border border-white/5 text-[11px] font-mono">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-2 py-0.5 rounded ${
              isActive ? 'text-emerald-400 bg-emerald-500/10' : 'text-zinc-400 hover:text-zinc-200'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>
  </div>
</header>
