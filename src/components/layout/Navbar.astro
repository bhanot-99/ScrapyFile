---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/work', label: 'WORK' },
  { href: '/services', label: 'SERVICES' },
  { href: '/about', label: 'ABOUT' },
  { href: '/contact', label: 'CONTACT' },
];
---

<header class="sticky top-0 z-50 w-full px-4 sm:px-6 pt-3 pb-2 transition-all duration-200">
  <div class="max-w-6xl mx-auto paper-frosted rounded-md px-4 sm:px-6 py-2.5 flex items-center justify-between border-[1.5px] border-[#111111] shadow-[3px_3px_0px_#111111]">
    <!-- Brand Stamped Monogram -->
    <a href="/" class="group flex items-center gap-2.5 font-mono text-xs sm:text-sm tracking-tight text-[#111111]">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-[#111111] border-[1.5px] border-[#111111] text-[#FFE600] font-black font-display text-xs shadow-[1.5px_1.5px_0px_#FF3B30] group-hover:translate-x-0.5 group-hover:translate-y-0.5 transition-transform">
        JB
      </span>
      <span class="font-black font-display text-sm tracking-tight text-[#111111]">JATIN BHANOT</span>
      <span class="text-[#4B4A47] hidden sm:inline">//</span>
      <span class="text-[#FF3B30] font-mono text-xs font-bold tracking-wider hidden sm:inline">TECH COPY</span>
    </a>

    <!-- Center Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs font-bold tracking-wider">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1 rounded-sm border-[1.5px] transition-all ${
              isActive
                ? 'bg-[#FFE600] text-[#111111] border-[#111111] shadow-[2px_2px_0px_#111111]'
                : 'border-transparent text-[#4B4A47] hover:text-[#111111] hover:bg-[#FAF8F3] hover:border-[#111111]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Availability Status & Project CTA -->
    <div class="flex items-center gap-3">
      <div class="hidden lg:flex items-center gap-2 px-2.5 py-1 rounded-sm bg-[#FFFDF9] border-[1.5px] border-[#111111] text-[11px] font-mono font-bold text-[#111111] shadow-[2px_2px_0px_#111111]">
        <span class="w-2 h-2 rounded-full bg-[#16A34A] animate-ping"></span>
        <span>Q4 / 2026: <strong class="text-[#16A34A]">2 SLOTS OPEN</strong></span>
      </div>

      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-sm text-xs font-mono font-bold tracking-wider uppercase bg-[#111111] text-[#FFE600] hover:bg-[#111111] hover:text-white border-[1.5px] border-[#111111] shadow-[3px_3px_0px_#FF3B30] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[4px_4px_0px_#FF3B30] active:translate-x-[1px] active:translate-y-[1px] transition-all"
      >
        <span>START PROJECT</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile Sub-Nav -->
  <div class="flex md:hidden justify-center gap-1.5 mt-2 px-2">
    <div class="bg-[#FFFDF9] px-2.5 py-1 rounded-sm flex items-center gap-1.5 border-[1.5px] border-[#111111] shadow-[2px_2px_0px_#111111] text-[11px] font-mono font-bold">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-2 py-0.5 rounded-sm border ${
              isActive ? 'bg-[#FFE600] text-[#111111] border-[#111111]' : 'border-transparent text-[#4B4A47]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>
  </div>
</header>
