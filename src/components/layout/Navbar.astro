---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 w-full px-4 sm:px-6 pt-3 pb-2 transition-all duration-200">
  <div class="max-w-6xl mx-auto bg-[#F4F1EA]/85 backdrop-blur-md rounded-2xl px-5 sm:px-6 py-3 flex items-center justify-between border border-[#1C1B19]/8 shadow-paper-sm">
    <!-- Brand Wordmark with Soft Lavender Tag -->
    <a href="/" class="group flex items-center gap-2.5 text-sm font-sans tracking-tight text-[#1C1B19]">
      <span class="font-extrabold text-base tracking-tight text-[#1C1B19]">Jatin Bhanot</span>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-[#E3DEFA] text-[11px] font-mono font-bold text-[#1C1B19]">
        Tech Copy
      </span>
    </a>

    <!-- Center Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 font-sans text-xs font-semibold">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3.5 py-1.5 rounded-full transition-all ${
              isActive
                ? 'bg-[#1C1B19] text-[#FDFBF7] shadow-sm'
                : 'text-[#57534E] hover:text-[#1C1B19] hover:bg-[#EAE5DA]/60'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Availability Status & Project CTA -->
    <div class="flex items-center gap-3">
      <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-[#D7F0DE] border border-[#1C1B19]/6 text-[11px] font-mono font-semibold text-[#1C1B19]">
        <span class="w-2 h-2 rounded-full bg-[#16A34A]"></span>
        <span>Q4 / 2026: <strong>2 Slots Open</strong></span>
      </div>

      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-full text-xs font-sans font-bold tracking-tight bg-[#1C1B19] text-[#FDFBF7] hover:bg-[#3D3A36] shadow-paper-sm hover:shadow-paper-md hover:-translate-y-0.5 active:translate-y-0 transition-all"
      >
        <span>Start a Project</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile Sub-Nav -->
  <div class="flex md:hidden justify-center gap-1.5 mt-2 px-2">
    <div class="bg-[#FDFBF7]/90 backdrop-blur-md px-3 py-1 rounded-full flex items-center gap-1.5 border border-[#1C1B19]/8 shadow-paper-sm text-[11px] font-sans font-semibold">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-2.5 py-1 rounded-full ${
              isActive ? 'bg-[#1C1B19] text-white' : 'text-[#57534E]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>
  </div>
</header>
