---
---

<footer class="w-full border-t border-white/8 bg-[#090A0B] mt-24">
  <!-- Conversion Callout Strip -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20 border-b border-white/5">
    <div class="sheen-card rounded-2xl p-8 sm:p-12 relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="max-w-2xl relative z-10">
        <span class="text-xs uppercase tracking-[0.18em] text-emerald-400 font-mono block mb-3">
          // ZERO FLUFF GUARANTEE
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white mb-4">
          Want a 2-minute video teardown of your developer homepage?
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base leading-relaxed mb-6">
          Send me your URL. I will record a private, hyper-specific Loom breaking down where your messaging leaks developer trust—and how an engineer would rewrite it. 100% free, no sales pitch.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/contact?teardown=true"
            class="px-5 py-2.5 rounded-lg text-xs font-mono font-medium tracking-wide bg-emerald-500 text-black hover:bg-emerald-400 transition-all glow-tactical inline-flex items-center gap-2"
          >
            <span>Request Free Teardown</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a
            href="/work"
            class="px-5 py-2.5 rounded-lg text-xs font-mono font-medium tracking-wide bg-zinc-900 border border-white/10 text-zinc-300 hover:text-white hover:border-zinc-700 transition-all"
          >
            Read Past Teardowns
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Links & Colophon -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-zinc-500 font-mono">
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-zinc-300 font-medium">JATIN BHANOT</span>
      </div>
      <span class="hidden sm:inline text-zinc-700">|</span>
      <span>Systems Engineer & Technical Copywriter</span>
    </div>

    <div class="flex items-center gap-6">
      <a href="https://github.com/bhanot1054" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">
        GitHub
      </a>
      <a href="https://linkedin.com/in/jatin-bhanot" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">
        LinkedIn
      </a>
      <a href="mailto:bhanot1054@gmail.com" class="hover:text-emerald-400 transition-colors">
        bhanot1054@gmail.com
      </a>
      <a href="/robots.txt" class="hover:text-zinc-300 transition-colors">
        robots.txt
      </a>
    </div>

    <div class="text-zinc-600 text-[11px]">
      Built with Astro 7 + Tailwind v4 + React 19 • 0 KB bloat
    </div>
  </div>
</footer>
