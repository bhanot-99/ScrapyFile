---
import HandDrawnDoodles from '../ui/HandDrawnDoodles.astro';
---

<footer class="w-full border-t border-[#1C1B19]/8 bg-[#ECE7DE]/50 mt-24">
  <!-- Conversion Callout Paper Sheet -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20 border-b border-[#1C1B19]/8">
    <div class="relative bg-[#FDFBF7] rounded-3xl p-8 sm:p-12 border border-[#1C1B19]/8 shadow-paper-md overflow-hidden">
      <!-- Translucent Masking Tape -->
      <div class="masking-tape masking-tape-lavender"></div>

      <div class="max-w-2xl relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 bg-[#FADEC9] border border-[#1C1B19]/10 px-3 py-1 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-[#1C1B19]"></span>
          <span class="text-[11px] tracking-wide text-[#1C1B19] font-mono font-semibold uppercase">
            // Zero Fluff Guarantee
          </span>
        </div>

        <div class="relative inline-block">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-[-0.03em] text-[#1C1B19] font-display leading-tight">
            Want a 2-minute video teardown of your developer homepage?
          </h2>
          <div class="opacity-70 mt-1">
            <HandDrawnDoodles type="squiggly-underline" width={110} height={10} color="#E3DEFA" />
          </div>
        </div>

        <p class="text-[#57534E] text-sm sm:text-base leading-relaxed font-sans font-medium">
          Send me your URL. I will record a private, hyper-specific Loom breaking down where your messaging leaks developer trust—and how an engineer would rewrite it. 100% free, no sales pitch.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/contact?teardown=true"
            class="px-5 py-3 rounded-full text-xs font-sans font-bold tracking-tight bg-[#1C1B19] text-[#FDFBF7] hover:bg-[#3D3A36] shadow-paper-sm hover:shadow-paper-md hover:-translate-y-0.5 active:translate-y-0 transition-all inline-flex items-center gap-2"
          >
            <span>Request Free Teardown</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a
            href="/work"
            class="px-5 py-3 rounded-full text-xs font-sans font-semibold bg-[#FDFBF7] border border-[#1C1B19]/12 text-[#1C1B19] hover:bg-[#EAE5DA] shadow-paper-sm transition-all"
          >
            Read Past Teardowns
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Links & Scrapbook Colophon -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-[#57534E] font-sans font-medium">
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#E3DEFA] border border-[#1C1B19]/20"></span>
        <span class="text-[#1C1B19] font-bold text-sm">Jatin Bhanot</span>
      </div>
      <span class="hidden sm:inline text-[#1C1B19]/20">•</span>
      <span>Systems Engineer & Technical Copywriter</span>
    </div>

    <div class="flex items-center gap-4 font-mono font-medium">
      <a href="https://github.com/bhanot1054" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-full bg-[#FDFBF7] border border-[#1C1B19]/8 hover:border-[#1C1B19]/30 transition-colors">
        GitHub
      </a>
      <a href="https://linkedin.com/in/jatin-bhanot" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-full bg-[#FDFBF7] border border-[#1C1B19]/8 hover:border-[#1C1B19]/30 transition-colors">
        LinkedIn
      </a>
      <a href="mailto:bhanot1054@gmail.com" class="px-2.5 py-1 rounded-full bg-[#E3DEFA] border border-[#1C1B19]/8 text-[#1C1B19] hover:bg-[#d8d1f7] transition-colors">
        bhanot1054@gmail.com
      </a>
      <a href="/robots.txt" class="text-[#8A857D] hover:text-[#1C1B19]">
        robots.txt
      </a>
    </div>

    <div class="text-[11px] text-[#8A857D] font-mono">
      Warm Scrapbook Paper-Craft • Astro 7 + Tailwind v4
    </div>
  </div>
</footer>
