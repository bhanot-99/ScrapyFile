---
interface Props {
  url?: string;
  title?: string;
}

const { url = 'https://agentradar.dev', title = 'Live Production Architecture' } = Astro.props;
---

<div class="w-full bg-[#FFFDF9] rounded-sm border-[1.5px] border-[#111111] shadow-[5px_5px_0px_#111111] overflow-hidden my-6">
  <!-- Top Browser Header -->
  <div class="bg-[#F3F1EC] px-4 py-2.5 border-b-[1.5px] border-[#111111] flex items-center justify-between gap-4">
    <div class="flex items-center gap-1.5 shrink-0">
      <span class="w-3 h-3 rounded-full bg-[#FF3B30] border border-[#111111]"></span>
      <span class="w-3 h-3 rounded-full bg-[#FFE600] border border-[#111111]"></span>
      <span class="w-3 h-3 rounded-full bg-[#16A34A] border border-[#111111]"></span>
    </div>

    <!-- URL bar -->
    <div class="flex-1 max-w-md mx-auto bg-white rounded-xs px-3 py-1 font-mono text-[11px] text-[#111111] text-center border-[1.5px] border-[#111111] shadow-[1.5px_1.5px_0px_#111111] truncate">
      <span class="text-[#2563EB] font-bold">https://</span>{url.replace('https://', '')}
    </div>

    <div class="text-[11px] font-mono font-bold text-[#4B4A47] hidden sm:block shrink-0 uppercase tracking-wider">
      {title}
    </div>
  </div>

  <!-- Browser Content Slot -->
  <div class="p-4 sm:p-6 bg-[#FAF8F3]">
    <slot />
  </div>
</div>
