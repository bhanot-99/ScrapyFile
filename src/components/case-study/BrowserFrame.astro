---
interface Props {
  url?: string;
  title?: string;
}

const { url = 'https://agentradar.dev', title = 'Live Production Architecture' } = Astro.props;
---

<div class="w-full bg-[#FDFBF7] rounded-2xl border border-[#1C1B19]/8 shadow-paper-md overflow-hidden my-8">
  <!-- Top Browser Header -->
  <div class="bg-[#FAF7F0] px-5 py-3 border-b border-[#1C1B19]/8 flex items-center justify-between gap-4">
    <div class="flex items-center gap-1.5 shrink-0">
      <span class="w-3 h-3 rounded-full bg-[#F7D6DE] border border-[#1C1B19]/10"></span>
      <span class="w-3 h-3 rounded-full bg-[#FADEC9] border border-[#1C1B19]/10"></span>
      <span class="w-3 h-3 rounded-full bg-[#D7F0DE] border border-[#1C1B19]/10"></span>
    </div>

    <!-- URL bar -->
    <div class="flex-1 max-w-md mx-auto bg-white rounded-full px-4 py-1.5 font-mono text-xs text-[#57534E] text-center border border-[#1C1B19]/8 shadow-sm truncate">
      <span class="text-[#1C1B19] font-semibold">https://</span>{url.replace('https://', '')}
    </div>

    <div class="text-[11px] font-mono font-medium text-[#8A857D] hidden sm:block shrink-0 uppercase tracking-wider">
      {title}
    </div>
  </div>

  <!-- Browser Content Slot -->
  <div class="p-5 sm:p-8 bg-[#FDFBF7]">
    <slot />
  </div>
</div>
