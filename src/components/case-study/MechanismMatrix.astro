---
interface Row {
  mechanism: string;
  benefit: string;
}

interface Props {
  rows: Row[];
  title?: string;
}

const { rows, title = "Mechanism-to-Benefit Translation Matrix" } = Astro.props;
---

<div class="bg-[#FDFBF7] rounded-2xl border border-[#1C1B19]/8 shadow-paper-md overflow-hidden my-8 font-mono">
  <div class="bg-[#ECE7DE] text-[#1C1B19] px-6 py-4 border-b border-[#1C1B19]/8 flex items-center justify-between">
    <span class="text-xs uppercase tracking-wider font-mono font-bold text-[#1C1B19]">
      // {title}
    </span>
    <span class="text-[11px] text-[#57534E] font-medium hidden sm:inline">Engineering Rigour → Revenue Lift</span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="bg-[#FAF7F0] border-b border-[#1C1B19]/8 text-[#57534E]">
          <th class="p-4 sm:p-5 font-bold w-1/2 uppercase tracking-wider border-r border-[#1C1B19]/8">Technical Mechanism (The "How It Works")</th>
          <th class="p-4 sm:p-5 font-bold w-1/2 text-[#16A34A] uppercase tracking-wider">Commercial Benefit (What The Buyer Buys)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#1C1B19]/6">
        {rows.map((row, idx) => (
          <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-[#FAF7F0]/60'}>
            <td class="p-4 sm:p-5 text-[#1C1B19] align-top leading-relaxed font-mono border-r border-[#1C1B19]/8">
              <div class="flex items-start gap-2.5">
                <span class="font-bold text-[#8A857D] select-none">0{idx + 1}.</span>
                <span class="font-medium">{row.mechanism}</span>
              </div>
            </td>
            <td class="p-4 sm:p-5 text-[#1C1B19] align-top leading-relaxed font-sans">
              <div class="flex items-start gap-2.5">
                <span class="text-[#16A34A] font-bold select-none font-mono">→</span>
                <span class="font-semibold text-[#1C1B19]">{row.benefit}</span>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
